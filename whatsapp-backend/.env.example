# Server
API_HOST=0.0.0.0
API_PORT=8005
FRONTEND_URL=http://localhost:3000

# Local persistence
DB_PATH=./data/whatsapp.db

# Meta WhatsApp Cloud API
# Keep real values in .env, never commit that file.
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_me
META_APP_SECRET=replace_me
WHATSAPP_VERIFY_TOKEN=sahay-sih-demo-2026
WHATSAPP_API_VERSION=v25.0

# Optional Groq response generation. The rule-based fallback works without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
